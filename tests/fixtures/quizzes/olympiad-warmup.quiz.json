{
  "schemaVersion": 1,
  "id": "olympiad-warmup",
  "title": "Mixed mathematics",
  "description": "Parity, congruences, geometry, counting, and probability.",
  "subject": "Mixed topics",
  "difficulty": "Olympiad",
  "durationMinutes": 20,
  "settings": {
    "shuffleQuestions": false,
    "shuffleOptions": false,
    "allowBack": true,
    "showSolutions": true,
    "penalty": 0
  },
  "assets": {
    "triangle.png": "data:image/png;base64,"
  },
  "questions": [
    {
      "id": "q1",
      "type": "choice",
      "prompt": "A sum of $2027$ odd integers is always:",
      "points": 2,
      "explanation": "\nEach odd integer is congruent to $1$ modulo $2$, so the sum is congruent to $2027\\equiv 1\\pmod{2}$.\n",
      "answerMode": "auto",
      "tolerance": 0.000001,
      "options": [
        {
          "id": "o1",
          "text": "Even"
        },
        {
          "id": "o2",
          "text": "Odd"
        },
        {
          "id": "o3",
          "text": "Divisible by $3$"
        },
        {
          "id": "o4",
          "text": "A prime number"
        }
      ],
      "answer": "o2"
    },
    {
      "id": "q2",
      "type": "open",
      "prompt": "Find the smallest positive integer $n$ for which\n\\[7n\\equiv 1\\pmod{10}.\\]",
      "points": 3,
      "explanation": "\nSince $7\\cdot 3=21\\equiv 1\\pmod{10}$, and $n=1,2$ do not work, the answer is $3$.\n",
      "answerMode": "auto",
      "tolerance": 0.000001,
      "answers": [
        "3"
      ]
    },
    {
      "id": "q3",
      "type": "choice",
      "prompt": "If $x+y=6$ and $xy=8$, what is $x^2+y^2$?",
      "points": 2,
      "explanation": "\nUse $x^2+y^2=(x+y)^2-2xy=36-16=20$.\n",
      "answerMode": "auto",
      "tolerance": 0.000001,
      "options": [
        {
          "id": "o1",
          "text": "$12$"
        },
        {
          "id": "o2",
          "text": "$16$"
        },
        {
          "id": "o3",
          "text": "$20$"
        },
        {
          "id": "o4",
          "text": "$28$"
        }
      ],
      "answer": "o3"
    },
    {
      "id": "q4",
      "type": "open",
      "prompt": "In triangle $ABC$, $\\angle A=50^\\circ$ and $\\angle B=60^\\circ$.\nFind $\\angle C$, in degrees. Enter the number only.\n\\includegraphics[width=0.8\\linewidth]{triangle.png}",
      "points": 3,
      "explanation": "\nThe interior angles of a triangle sum to $180^\\circ$, hence $\\angle C=180^\\circ-50^\\circ-60^\\circ=70^\\circ$.\n",
      "answerMode": "auto",
      "tolerance": 0.000001,
      "answers": [
        "70"
      ]
    },
    {
      "id": "q5",
      "type": "choice",
      "prompt": "How many subsets does a set with $4$ elements have, including the empty set?",
      "points": 2,
      "explanation": "\nEach element is either included or excluded. These independent choices give $2^4=16$ subsets.\n",
      "answerMode": "auto",
      "tolerance": 0.000001,
      "options": [
        {
          "id": "o1",
          "text": "$8$"
        },
        {
          "id": "o2",
          "text": "$12$"
        },
        {
          "id": "o3",
          "text": "$16$"
        },
        {
          "id": "o4",
          "text": "$24$"
        }
      ],
      "answer": "o3"
    },
    {
      "id": "q6",
      "type": "open",
      "prompt": "Find the sum\n\\[1+2+3+\\cdots+100.\\]",
      "points": 3,
      "explanation": "\nPair the first and last terms to obtain $50\\cdot101=5050$.\n",
      "answerMode": "auto",
      "tolerance": 0.000001,
      "answers": [
        "5050"
      ]
    },
    {
      "id": "q7",
      "type": "choice",
      "prompt": "Two diagonally opposite corners are removed from an $8\\times8$ chessboard.\nCan the remaining board be tiled with $1\\times2$ dominoes?",
      "points": 2,
      "explanation": "\nThe removed squares have the same colour. Every domino covers one square of each colour, but the remaining board has unequal numbers of the two colours.\n",
      "answerMode": "auto",
      "tolerance": 0.000001,
      "options": [
        {
          "id": "o1",
          "text": "Yes, for every such pair of corners"
        },
        {
          "id": "o2",
          "text": "Yes, but only using vertical dominoes"
        },
        {
          "id": "o3",
          "text": "No"
        },
        {
          "id": "o4",
          "text": "There is not enough information"
        }
      ],
      "answer": "o3"
    },
    {
      "id": "q8",
      "type": "open",
      "prompt": "Two fair six-sided dice are rolled. What is the probability that their sum is $7$?\nYou may enter a fraction.",
      "points": 3,
      "explanation": "\nThere are $6$ favourable ordered outcomes among $36$ equally likely outcomes. The probability is $6/36=1/6$.\n",
      "answerMode": "auto",
      "tolerance": 0.000001,
      "answers": [
        "1/6",
        "\\frac{1}{6}"
      ]
    }
  ]
}
