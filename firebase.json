{
  "functions": [
    {
      "source": "functions",
      "codebase": "mathquiz",
      "runtime": "nodejs22",
      "predeploy": [
        "node scripts/sync-functions-shared.mjs"
      ],
      "ignore": [
        "node_modules",
        "test",
        "*.log"
      ]
    }
  ],
  "firestore": {
    "rules": "firebase/firestore.rules",
    "indexes": "firebase/firestore.indexes.json"
  },
  "storage": {
    "rules": "firebase/storage.rules"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "functions": {
      "port": 5001
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
